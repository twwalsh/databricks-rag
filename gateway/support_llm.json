{
  "comment": "The support assistant's generator, behind Unity Gateway: Llama 3.3 70B with Llama 3.1 8B as fallback, per-caller and per-service rate limits, every request logged to workspace.rag.support_llm_payload.",
  "config": {
    "routing": {
      "destinations": [
        {
          "name": "llama-3-3-70b",
          "destination_type": "DESTINATION_TYPE_PAY_PER_TOKEN_FOUNDATION_MODEL",
          "pay_per_token_config": {
            "model": "models/system.ai.llama_v3_3_70b_instruct"
          }
        }
      ],
      "fallback": {
        "destinations": [
          {
            "name": "llama-3-1-8b",
            "destination_type": "DESTINATION_TYPE_PAY_PER_TOKEN_FOUNDATION_MODEL",
            "pay_per_token_config": {
              "model": "models/system.ai.meta_llama_v3_1_8b_instruct"
            }
          }
        ]
      }
    },
    "rate_limits": [
      {
        "key": "RATE_LIMIT_KEY_USER_DEFAULT",
        "renewal_period": "RATE_LIMIT_RENEWAL_PERIOD_MINUTE",
        "requests": 30,
        "tokens": 60000
      },
      {
        "key": "RATE_LIMIT_KEY_SERVICE",
        "renewal_period": "RATE_LIMIT_RENEWAL_PERIOD_HOUR",
        "requests": 600,
        "tokens": 1500000
      }
    ],
    "inference_table": {
      "parent": "schemas/workspace.rag",
      "table_name_prefix": "support_llm"
    }
  }
}